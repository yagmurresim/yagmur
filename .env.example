# ─── Site ─────────────────────────────────────────────────────────────────────
# Local: http://localhost:3000
# Production: https://yagmursanat.com
NEXT_PUBLIC_SITE_URL=https://yagmursanat.com

# ─── Supabase ─────────────────────────────────────────────────────────────────
# From Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhb...

# Service role key — NEVER expose as NEXT_PUBLIC_ — server only
SUPABASE_SERVICE_ROLE_KEY=eyJhb...

# ─── Rate limiting (opsiyonel; boşsa form yine çalışır, Upstash yok) ─────────
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ─── Intro booking mail (optional — skip silently if unset) ───────────────────
# RESEND_API_KEY=re_...
# NOTIFY_EMAIL=akademi@example.com
# NOTIFY_FROM=Yağmur Sanat <noreply@yagmursanat.com>

# ─── Analytics (optional) ─────────────────────────────────────────────────────
# Choose one provider (or none)
NEXT_PUBLIC_ANALYTICS_PROVIDER=none   # none | plausible | ga4

# Plausible
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=yagmursanat.com

# Google Analytics 4
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
