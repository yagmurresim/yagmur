# ─── Site ─────────────────────────────────────────────────────────────────────
# Set to your production domain before launch
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Supabase ─────────────────────────────────────────────────────────────────
# From Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhb...

# Service role key — NEVER expose as NEXT_PUBLIC_ — server only
SUPABASE_SERVICE_ROLE_KEY=eyJhb...

# ─── Rate limiting (unused — public form removed) ────────────────────────────
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ─── Analytics (optional) ─────────────────────────────────────────────────────
# Choose one provider (or none)
NEXT_PUBLIC_ANALYTICS_PROVIDER=none   # none | plausible | ga4

# Plausible
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=yourdomain.com

# Google Analytics 4
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
